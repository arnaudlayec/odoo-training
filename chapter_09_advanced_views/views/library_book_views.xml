<odoo>
    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <!-- widget="handle" : poignée de glisser-déposer sur un champ Integer -->
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="isbn" optional="hide"/>
                <field name="date_release"/>
                <field name="page_count" optional="hide"/>
                <field name="price" />
                <field name="state" widget="badge" />
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <!-- widget="statusbar" : le fil d'étapes en haut de formulaire, toujours
                     placé dans un <header/> hors du <sheet>. statusbar_visible restreint
                     les valeurs affichées dans le fil (les autres restent accessibles via
                     le menu déroulant "Autre"). -->
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,available,borrowed" options="{'clickable': 1}"/>
                </header>
                <sheet>
                    <!-- widget="web_ribbon" : bandeau en haut à droite du formulaire, affiché
                         ou non selon une expression Python comme n'importe quel "invisible". -->
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Perdu" bg_color="text-bg-danger" invisible="state != 'lost'"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_view_category_books"
                                class="oe_stat_button"
                                icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Livres de la catégorie</span>
                            </div>
                        </button>
                    </div>

                    <field name="cover" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="isbn"/>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_release"/>
                            <!-- options type/step sur un champ numérique : bascule l'input
                                 HTML natif en <input type="number">, avec les flèches
                                 d'incrément/décrément fournies par le navigateur. -->
                            <field name="page_count" options="{'type': 'number', 'step': 1}" />
                            <field name="active" widget="boolean_toggle" />
                            <!-- Attribut dynamique v19 : "invisible" prend directement une
                                 expression Python sur les champs du formulaire (fini les
                                 dictionnaires `attrs`/`states` des versions < 17). -->
                            <field name="price" invisible="state == 'lost'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue search : champs de recherche, filtres et regroupements proposés à droite/en
         haut de la vue liste/kanban. Un filtre est activé par défaut via le context de
         l'action (search_default_<name_du_filtre>). -->
    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="isbn"/>
                <filter string="Disponibles" name="filter_available"
                        domain="[('state', '=', 'available')]"/>
                <filter string="Empruntés" name="filter_borrowed"
                        domain="[('state', '=', 'borrowed')]"/>
                <separator/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Catégorie" name="groupby_category"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Étiquettes" name="groupby_tags"
                            context="{'group_by': 'tag_ids'}"/>
                    <filter string="État" name="groupby_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Kanban basique, groupée par catégorie par défaut -->
    <record id="library_book_view_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id">
                <field name="category_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="cover" widget="image" alt="Cover" />
                        </aside>
                        <main class="ms-2">
                            <field class="fw-bold fs-5" name="display_name"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <footer>
                                <field name="state" widget="badge" />
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Livres</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="library_book_view_search"/>
        <!-- Une seule action pour tous les livres. "active" est activé par défaut
             (search_default_active), et active_test: False désactive le filtre implicite
             active=True qu'Odoo applique sinon automatiquement — sans ça, décocher "Actifs"
             ne ferait jamais apparaître les livres archivés. -->
        <field name="context">{"search_default_active": 1, "active_test": False}</field>
    </record>

    <menuitem id="menu_library_root"
              name="Bibliothèque"
              web_icon="library,static/description/icon.png"
              sequence="10">
        <menuitem id="menu_library_book"
                  name="Livres"
                  action="action_library_book"
                  sequence="10"/>
    </menuitem>
</odoo>
