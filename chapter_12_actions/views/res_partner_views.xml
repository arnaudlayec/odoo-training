<odoo>
    <record id="view_partner_form_inherit_library_theme" model="ir.ui.view">
        <field name="name">res.partner.form.library</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Livres empruntés" name="borrowed_books">
                    <field name="borrowed_book_ids" />
                </page>
            </notebook>

            <field name="vat" position="attributes">
                <attribute name="invisible">context.get('library_simplified_view', False)</attribute>
            </field>
            <field name="website" position="attributes">
                <attribute name="invisible">context.get('library_simplified_view', False)</attribute>
            </field>
        </field>
    </record>

    <record id="view_partner_tree_inherit_library_theme" model="ir.ui.view">
        <field name="name">res.partner.list.library</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>

        <field name="arch" type="xml">
            <list position="inside">
                <field name="borrowed_book_ids" widget="many2many_tags" />
            </list>

            <field name="vat" position="attributes">
                <attribute name="column_invisible">context.get('library_simplified_view', False)</attribute>
            </field>
            <field name="application_statistics" position="attributes">
                <attribute name="column_invisible">context.get('library_simplified_view', False)</attribute>
            </field>
        </field>
    </record>

    <record id="action_library_partner_borrowers" model="ir.actions.act_window">
        <field name="name">Emprunteurs</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("borrowed_book_ids", "!=", False)]</field>
        <field name="context">{"library_simplified_view": True}</field>
    </record>

    <menuitem id="menu_library_partner_borrowers"
              name="Emprunteurs"
              parent="menu_library_root"
              action="action_library_partner_borrowers"
              sequence="30"/>
</odoo>
