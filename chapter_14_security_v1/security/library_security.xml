<odoo>
    <record id="module_category_library" model="ir.module.category">
        <field name="name">Bibliothèque</field>
    </record>

    <record id="res_groups_privilege_library" model="res.groups.privilege">
        <field name="name">Bibliothèque</field>
        <field name="category_id" ref="module_category_library" />
    </record>

    <record id="group_library_reader" model="res.groups">
        <field name="name">Lecteur</field>
        <field name="privilege_id" ref="res_groups_privilege_library" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_library_librarian" model="res.groups">
        <field name="name">Bibliothécaire</field>
        <field name="privilege_id" ref="res_groups_privilege_library" />
        <field name="implied_ids" eval="[(4, ref('library.group_library_reader'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
