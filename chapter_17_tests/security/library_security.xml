<odoo>
    <record id="module_category_library" model="ir.module.category">
        <field name="name">Bibliothèque</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_library">
        <field name="name">Bibliothèque</field>
        <field name="category_id" ref="module_category_library" />
    </record>

    <record id="group_library_reader" model="res.groups">
        <field name="name">Lecteur</field>
        <field name="privilege_id" ref="res_groups_privilege_library" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_library_librarian" model="res.groups">
        <field name="name">Bibliothécaire</field>
        <field name="privilege_id" ref="res_groups_privilege_library" />
        <field name="implied_ids" eval="[(4, ref('library.group_library_reader'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="library_book_rule_reader" model="ir.rule">
        <field name="name">Lecteur : livres actifs uniquement</field>
        <field name="model_id" ref="model_library_book"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_library_reader'))]"/>
    </record>

    <!-- group_library_librarian implique group_library_reader (chapitre 14) : un bibliothécaire
         appartient donc aussi au groupe Lecteur, et la règle ci-dessus s'appliquerait à lui aussi.
         Plusieurs règles de GROUPE se combinent en OU : cette règle permissive, propre au groupe
         Bibliothécaire, neutralise la restriction héritée du groupe Lecteur. -->
    <record id="library_book_rule_librarian" model="ir.rule">
        <field name="name">Bibliothécaire : tous les livres, y compris archivés</field>
        <field name="model_id" ref="model_library_book"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_librarian'))]"/>
    </record>
</odoo>
